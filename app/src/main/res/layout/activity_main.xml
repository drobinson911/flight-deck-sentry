<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Column 1: status, drone, sources, controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_bg"
            android:gravity="center_vertical"
            android:minHeight="78dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/bg"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/replayProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progressTint="@color/replay"
            android:visibility="gone" />

        <LinearLayout
            style="@style/Sentry.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <TextView style="@style/Sentry.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drone (ownship)" />
            <TextView android:id="@+id/drone" style="@style/Sentry.Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/droneDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dim" android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Sentry.Panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/Sentry.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sources" />
            <TextView android:id="@+id/sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="16sp" android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArm"
                style="@style/Sentry.Button"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1.4"
                android:textSize="24sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Sentry.Button"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/panel2"
                android:text="Test callout"
                android:textColor="@color/ink" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Sentry.Button"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginStart="8dp"
                android:layout_weight="0.9"
                android:backgroundTint="@color/panel2"
                android:text="Settings"
                android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- Column 2: radar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="0.95"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <com.uasflightdeck.sentry.RadarView
            android:id="@+id/radar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/zones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Column 3: targets, callouts, log -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1.2"
        android:orientation="vertical">
        <LinearLayout
            style="@style/Sentry.Panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/targetsLabel" style="@style/Sentry.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Targets" />
            <TextView android:id="@+id/targets" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="16sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <LinearLayout
            style="@style/Sentry.Panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1.25"
            android:orientation="vertical">
            <TextView style="@style/Sentry.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Last callouts" />
            <TextView android:id="@+id/callouts" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:lineSpacingExtra="4dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:maxLines="4"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
