<?xml version="1.0" encoding="utf-8"?>
<!--
  0.4.5 expanded (pulled-down) form of the non-traffic card: title + the full body (several lines, e.g. the
  pre-flight failures) + an optional action row of our own buttons (status: Disarm · Open Sentry).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/banner_bg">
    <ImageView android:id="@+id/bStripe" android:layout_width="5dp" android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/bTitle" style="@style/Sentry.BannerText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/bLine2" style="@style/Sentry.BannerText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:layout_marginTop="4dp"
            android:maxLines="8" />
        <LinearLayout android:id="@+id/bActions" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="9dp" android:visibility="gone">
            <TextView android:id="@+id/bAct1" style="@style/Sentry.BannerButton" android:layout_width="wrap_content"
                android:layout_height="40dp" />
            <TextView android:id="@+id/bAct2" style="@style/Sentry.BannerButton" android:layout_width="wrap_content"
                android:layout_height="40dp" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
