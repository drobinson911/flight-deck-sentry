<?xml version="1.0" encoding="utf-8"?>
<!--
  The heads-up form of the traffic banner. Android 10 gives a decorated heads-up only ~58 dp of content height
  between its header and the action row, so the four lines sit in three rows: title / where / prediction + hint
  (the hint right-aligned on the prediction's row). The expanded form (banner_4line.xml) has one line each.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/bTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:textStyle="bold" android:textSize="15sp"
        android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/bLine2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" android:textSize="13sp"
        android:includeFontPadding="false" android:layout_marginTop="2dp" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView android:id="@+id/bLine3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/bLine4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" android:textSize="13sp" android:textStyle="bold"
            android:includeFontPadding="false" android:layout_marginStart="12dp" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
