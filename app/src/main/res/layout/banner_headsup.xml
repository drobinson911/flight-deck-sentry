<?xml version="1.0" encoding="utf-8"?>
<!--
  0.4.4 heads-up form of the traffic banner: compact, two text rows + our own action row, on our own opaque dark
  card (no DecoratedCustomViewStyle, no system text appearance: every colour is explicit).
    row 1: level + who (coloured) · where           "⚠ WARNING · N388KM · SW 1.9 mi · 155 kt · ≈100 below"
    row 2: closure / time            hint (right)    "Closest 2,700 ft in 40 s             Clear: move NW ↑"
    actions: Got it · Ignore · Quiet 5 min          (GONE on COLLISION RISK)
  The expanded form (banner_4line.xml) keeps one line each.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/banner_bg">
    <ImageView android:id="@+id/bStripe" android:layout_width="5dp" android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="7dp" android:paddingBottom="7dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/bTitle" style="@style/Sentry.BannerText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/bLine2" style="@style/Sentry.BannerText" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:id="@+id/bLine3" style="@style/Sentry.BannerText" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/bLine4" style="@style/Sentry.BannerText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bActions" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="7dp">
            <TextView android:id="@+id/bGotIt" style="@style/Sentry.BannerButton" android:layout_width="wrap_content"
                android:layout_height="36dp" android:text="Got it" />
            <TextView android:id="@+id/bIgnore" style="@style/Sentry.BannerButton" android:layout_width="wrap_content"
                android:layout_height="36dp" android:layout_marginStart="10dp" android:text="Ignore" />
            <TextView android:id="@+id/bQuiet" style="@style/Sentry.BannerButton" android:layout_width="wrap_content"
                android:layout_height="36dp" android:layout_marginStart="10dp" android:text="Quiet 5 min" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
